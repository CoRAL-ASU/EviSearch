# Copy to .env (git-ignored) and fill in what your preset needs. Run `python -m src.config --check` to verify.

# --- Inference selection (optional; defaults live in src/config/config.py) ---
# EVISEARCH_PRESET=local                  # local | offline | cloud
# EVISEARCH_ROLE_JUDGE=gemini-2.5-pro     # override any role with a catalog model key
# EVISEARCH_PDF_QUERY_INPUT=markdown      # markdown | pdf
# EVISEARCH_GPU_POOL=0,1,2,3
# EVISEARCH_GPUS=qwen36_27b=0;qwen3_embed_8b=1;qwen3_rerank_8b=1
# EVISEARCH_VLLM_BIN=/path/to/vllm              # default: vllm installed in the project venv
# EVISEARCH_VLLM_CHAT_URL=http://other-host:8002/v1   # use a vLLM server running elsewhere

# --- Gemini on Vertex AI (cloud/local presets use it for judge and baselines) ---
VERTEX_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- OpenAI (cloud preset embeddings, GPT baselines) ---
OPENAI_API_KEY=

# --- LandingAI document parsing (preparing new PDFs) ---
VISION_AGENT_API_KEY=
