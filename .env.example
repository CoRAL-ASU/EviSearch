# Copy to .env (git-ignored). `python -m src.config --check` verifies what the selected preset needs.

# The default `openrouter` preset: the three agents and the embedding model.
OPEN_ROUTER_API_KEY=

# Landing AI layout parsing, needed only to add new PDFs (the benchmark papers ship parsed).
VISION_AGENT_API_KEY=

# --- Optional ---
# EVISEARCH_PRESET=local                        # openrouter (default) | local | offline | cloud_openai
# EVISEARCH_GPU_POOL=4,5,6,7                    # GPUs the local preset may use
# EVISEARCH_VLLM_CHAT_URL=http://host:8002/v1   # a vLLM server running elsewhere
# EVISEARCH_MAX_INFLIGHT=64                     # model calls in flight at once (src/inference/limits.py)
# OPENAI_API_KEY=                               # the cloud_openai preset
# EVISEARCH_DEMO_PASSWORD=                      # HTTP Basic auth for a public deployment
